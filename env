# Description:  Set required environment variables.
# Usage:        `source ./env`
# To do:        Write in error handling.

unset _EXPERIMENTAL_DAGGER_RUNNER_HOST

log(){
    local MSG="${1:?}"          # Log message
    local LEVEL="${2:-INFO}"    # Log level
    local CLR='\033[0m'         # No color
    local GRN='\033[0;32m'      # Green
    local YLW='\033[0;33m'      # Yellow
    local RED='\033[0;31m'      # Red
    local COLOR="${CLR}"        # Default log message color
    local EXIT=false            # Exit after log
    local OUT=1                 # STDOUT
    local RC=0                  # Return code

    # ANSI color codes
    case "${LEVEL}" in
        'DEBUG')    COLOR="${CLR}" ;;
        'INFO')     COLOR="${GRN}" ;;
        "WARN*")    COLOR="${YLW}" ;;
        "ERR*")
            COLOR="${YLW}"
            OUT=2
            ;;
        "CRIT*|FATAL")
            COLOR="${RED}"
            EXIT=true
            OUT=2
            RC=1
            ;;
    esac

    printf '%b%-10s %-80s%b\n' "${COLOR}" "${LEVEL}" "${MSG}" "${CLR}" >&"${OUT}"

    if [ "${EXIT}" == true ]; then
        printf 'Exiting.'
        exit "${RC}"
    else
        return "${RC}"
    fi
}

load_aws() {
    if ! which aws > /dev/null 2>&1; then log 'AWS CLI not installed.' FATAL; fi
    if ! aws sts get-caller-identity > /dev/null 2>&1; then log 'Not logged in in to AWS.' FATAL; fi

    eval "$(aws configure export-credentials --format env)"

    log 'Setting AWS environment variables.'
    log '* AWS_ACCESS_KEY_ID' DEBUG
    export AWS_ACCESS_KEY_ID
    log '* AWS_SECRET_ACCESS_KEY' DEBUG
    export AWS_SECRET_ACCESS_KEY
    log '* AWS_SESSION_TOKEN' DEBUG
    export AWS_SESSION_TOKEN
    log '* AWS_CREDENTIAL_EXPIRATION' DEBUG
    export AWS_CREDENTIAL_EXPIRATION
    log 'Done.\n'
}

load_github() {
    if ! which gh > /dev/null 2>&1; then log 'GitHub CLI not installed.' FATAL; fi
    if ! gh auth token > /dev/null 2>&1; then log 'Not logged in to GitHub CLI.' FATAL; fi

    log 'Setting GitHub environment variables.'
    log '* GITHUB_TOKEN' DEBUG

    GITHUB_TOKEN="$(gh auth token)"

    export GITHUB_TOKEN

    log 'Done.\n'
}

login_ecr() {
    if ! which aws > /dev/null 2>&1; then log 'AWS CLI not installed.' FATAL; fi

    # shellcheck disable=SC2016
    if [ -z "${ECR}" ]; then log 'Need to set $ECR.' FATAL; fi

    log 'Logging into AWS ECR.'

    aws ecr get-login-password                                          \
    | docker login                                                      \
        --username AWS                                                  \
        --password-stdin                                                \
        "${ECR}"

    log 'Done.\n'
}

setup_kubernetes_environment() {
    if ! which helm > /dev/null 2>&1; then log 'Helm not installed.' FATAL; fi
    if ! which kubectl > /dev/null 2>&1; then log 'kubectl not installed.' FATAL; fi

    local DAGGER_ENGINE_POD_NAME

    log 'Setting up dagger namespace.'

    helm upgrade                                                            \
        --install                                                           \
        --namespace=dagger                                                  \
        --create-namespace                                                  \
        dagger                                                              \
        oci://registry.dagger.io/dagger-helm

    kubectl wait                                                            \
        --for condition=Ready                                               \
        --timeout=60s                                                       \
        pod                                                                 \
        --selector=name=dagger-dagger-helm-engine                           \
        --namespace=dagger

    DAGGER_ENGINE_POD_NAME="$(kubectl get pod                               \
        --selector=name=dagger-dagger-helm-engine                           \
        --namespace=dagger                                                  \
        --output=jsonpath='{.items[0].metadata.name}'                       \
    )"

    _EXPERIMENTAL_DAGGER_RUNNER_HOST="kube-pod://${DAGGER_ENGINE_POD_NAME}?namespace=dagger"

    export _EXPERIMENTAL_DAGGER_RUNNER_HOST

    log 'Done\n.'
}

load_aws
load_github
login_ecr

if [[ "${1:-}" == '--kubernetes' ]]; then setup_kubernetes_environment; fi

log 'Environment is ready.'
